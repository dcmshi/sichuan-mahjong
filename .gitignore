node_modules/
dist/
.DS_Store
*.db
*.db-journal

# Playwright artifacts, the e2e/shots throwaway database (A79), and
# `scripts/perf/interaction-probe.mjs`'s per-run JSON. Same rule as
# prototype-shots/ below: working evidence, not a deliverable — the numbers that
# matter go in docs/optimization.md and the probe regenerates the rest.
test-results/

# Generated at binary-build time (embedded client SPA); Bun-only, never committed
packages/server/src/generated/
dist-bin/

# Subagent scratch (briefs, reports, ledgers) — never part of the source tree
.superpowers/

# Tile sandbox renders. The page is the tool (open it directly); the PNG is a
# scratch artifact you regenerate, so it would only churn in review.
scripts/tiles/sandbox.png
scripts/tiles/*.local.png

# Layout probe output. `scripts/screenshots/layout-probe.mjs` writes a labelled
# directory of nine PNGs per run, and a session comparing options accumulates
# tens of megabytes of them. They are working evidence, not a deliverable — the
# findings go in docs/layout_investigation.md and the probe regenerates the
# images on demand. Contrast docs/*.png, which ARE committed: those are the
# README's screenshots, generated by `pnpm shots`.
prototype-shots/

# Stryker's sandbox and report output. It copies the whole package in to mutate
# it, so vitest collected the copy's tests and biome linted its generated
# tsconfig — engine tests read 528 instead of 264 until this was ignored. The
# tool excludes are in vitest.config.ts and biome.json; this is only for git.
.stryker-tmp/
reports/mutation/

# LLM session exports — working transcripts, not part of the source tree.
kimi-export-session_*.md

# Coverage reports. `pnpm test:coverage` is a documented command and it writes a
# directory of generated HTML/CSS per package — which biome then lints and
# reformats, so running it broke `pnpm lint` until you deleted the output by
# hand. Ignored here and in biome.json.
coverage/

# Local scratch — probes, throwaway tests, audit harnesses. A `zz-` prefix keeps
# a file out of git *and* out of `pnpm lint` (biome.json reads this file via
# `vcs.useIgnoreFile`), so a half-finished probe can no longer fail lint for
# code nobody will commit. Vitest does not read .gitignore, so a scratch test
# still runs locally — which is how A87 was found. (A89)
zz-*
